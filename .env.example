# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USER_IDS=123456789
OWNER_CHAT_ID=your_telegram_chat_id_here

# TMDb
TMDB_API_KEY=your_tmdb_api_key_here

# TMDb adaptive polling (Phase 7.5)
TMDB_MIN_CALL_INTERVAL=1.5        # seconds between consecutive TMDb calls
TMDB_MAX_CALLS_PER_MINUTE=30      # rolling per-minute cap on requests
TMDB_429_BACKOFF_BASE_SECONDS=5.0 # initial wait on HTTP 429 (doubles per retry)
TMDB_429_MAX_RETRIES=3            # retries after the first 429
POLL_SCAN_INTERVAL_SECONDS=120    # how often the scheduler scans for due items

# IGDB
IGDB_CLIENT_ID=your_igdb_client_id_here
IGDB_CLIENT_SECRET=your_igdb_client_secret_here

# KinoPub (OAuth device flow)
KINOPUB_CLIENT_ID=kinopub_client_id_here
KINOPUB_CLIENT_SECRET=kinopub_client_secret_here
KINOPUB_ACCESS_TOKEN=  # filled after device flow auth

# PlayStation Store region
PS_STORE_REGION=US
