# Скопируйте этот файл в .env и подставьте свои значения. Файл .env никуда не отправляйте.
# Не используйте в значениях знак $: Docker его портит, и .\start-bot.ps1 не запустит бота, пока он есть.

# Токен бота. Обязательно. Получить: в Telegram написать @BotFather, команда /newbot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Номера пользователей Telegram, которым можно пользоваться ботом (через запятую). Обязательно: с пустым списком бот не запустится. Узнать свой номер: написать @userinfobot.
ALLOWED_TELEGRAM_USER_IDS=123456789

# Номер чата, куда бот присылает события и отчёты об ошибках. Необязательно: если не задан или не число, берётся первый из ALLOWED_TELEGRAM_USER_IDS.
OWNER_CHAT_ID=

# Часовой пояс владельца (тихие часы, час сводки, время серий аниме). Необязательно, но лучше задать: иначе используется UTC. Пример: Europe/Moscow.
BOT_TIMEZONE=Europe/Moscow

# Ключ TMDb (фильмы и сериалы). Обязательно. Получить бесплатно: themoviedb.org, Настройки -> API.
TMDB_API_KEY=your_tmdb_api_key_here

# Ограничения частоты запросов к TMDb. Необязательно, значения по умолчанию подходят.
# Пауза между запросами, секунд:
TMDB_MIN_CALL_INTERVAL=1.5
# Не больше запросов в минуту:
TMDB_MAX_CALLS_PER_MINUTE=30
# Пауза после ответа 429 («слишком часто»), секунд; с каждой попыткой удваивается:
TMDB_429_BACKOFF_BASE_SECONDS=5.0
# Сколько раз повторять после ответа 429:
TMDB_429_MAX_RETRIES=3

# Ключ IGDB (игры), часть 1. Необязательно, понадобится, когда в боте появятся игры. Получить: dev.twitch.tv, раздел Applications (Client ID).
IGDB_CLIENT_ID=your_igdb_client_id_here
# Ключ IGDB (игры), часть 2. Необязательно, там же (Client Secret).
IGDB_CLIENT_SECRET=your_igdb_client_secret_here

# Пароль для входа в веб-приложение (http://localhost:8080). Придумайте свой, не короче 8 символов, без знака $. Без пароля (или с коротким) вход закрыт, а бот работает как обычно. Смените пароль — все, кто вошёл, выйдут и войдут заново.
WEB_PASSWORD=

# Порт, на котором приложение открывается на этом компьютере: http://localhost:8080. Необязательно. Занят — впишите другой, например 8081.
WEB_PORT=8080

# Кто может открыть приложение. 127.0.0.1 — только этот компьютер (по умолчанию). 0.0.0.0 — ещё и устройства домашней сети (телефон по адресу http://<адрес компьютера в сети>:8080). Вход по паролю остаётся, но связь не шифруется: включайте только дома, в сети без чужих. Необязательно.
WEB_HOST=127.0.0.1

# Номер пользователя, от которого работает бот в Docker. Необязательно (по умолчанию 1000). На обычном ПК с Windows менять не нужно; на NAS впишите номер владельца папки data.
PUID=1000
# Номер группы, от которой работает бот в Docker. Необязательно (по умолчанию 1000); на NAS — группа владельца папки data.
PGID=1000
